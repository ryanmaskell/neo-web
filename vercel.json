{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "framework": null,
  "build": { "env": { "ELECTRON_SKIP_BINARY_DOWNLOAD": "1" } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(sw.js|config.js|index.html|)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
